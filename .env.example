OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=akshay.kumar@onesmarter.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=akshay.kumar@onesmarter.com
SMTP_REPLY_TO=care@onesmarter.com

# Private BCC recipient for each requested scan report.
REPORT_COPY_TO=care@onesmarter.com

# Internal recipient for structured human follow-up requests.
LEAD_TO_EMAIL=care@onesmarter.com

# Generated OneSmarter source-of-truth file used at runtime.
# llms-full.txt is preferred when it is available; llms.txt is supported.
ONESMARTER_KNOWLEDGE_URL=https://onesmarter.com/llms-full.txt

# Optional alternative to URL-based knowledge loading.
# ONESMARTER_KNOWLEDGE_TEXT=

# Supabase server-side destinations. Never expose the secret key in browser
# code. New projects can use SUPABASE_SECRET_KEY; the legacy
# SUPABASE_SERVICE_ROLE_KEY is also supported by the backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANALYTICS_TABLE=practice_campaign_events
SUPABASE_REPORT_REQUESTS_TABLE=practice_report_requests

# Optional additional HTTPS analytics destination.
ANALYTICS_WEBHOOK_URL=
