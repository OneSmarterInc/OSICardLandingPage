{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "functions": {
    "api/practice.js": {
      "maxDuration": 60
    },
    "api/practice-smtp.js": {
      "maxDuration": 60
    },
    "api/analytics.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/A",
      "destination": "/a",
      "permanent": false
    },
    {
      "source": "/B",
      "destination": "/b",
      "permanent": false
    },
    {
      "source": "/:path((?!api/|api$|practices/|practices$|qr-codes/|qr-codes$|qr-codes-production/|qr-codes-production$|docs/|docs$).+[aA])",
      "destination": "/a",
      "permanent": false
    },
    {
      "source": "/:path((?!api/|api$|practices/|practices$|qr-codes/|qr-codes$|qr-codes-production/|qr-codes-production$|docs/|docs$).+[bB])",
      "destination": "/b",
      "permanent": false
    },
    {
      "source": "/:path((?![aAbB]$|api/|api$|practices/|practices$|qr-codes/|qr-codes$|qr-codes-production/|qr-codes-production$|docs/|docs$).+)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/practices/app.html"
    },
    {
      "source": "/a",
      "destination": "/practices/app.html"
    },
    {
      "source": "/b",
      "destination": "/practices/app.html"
    },
    {
      "source": "/practices",
      "destination": "/practices/app.html"
    }
  ]
}